# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Preview mode for client reviews WITHOUT a backend: shows the bundled sample hotels/packages,
# inquiries open WhatsApp, and the admin area is disabled. Set to "true" on Vercel for the preview;
# remove it (or set "false") once the real API is deployed.
# NEXT_PUBLIC_PREVIEW_MODE=true

# Public URL of the Way To Kaaba API (no trailing slash). Not needed in preview mode.
# Local:      http://localhost:5062
# Production: https://api.<client-domain>   (your API URL — never localhost)
# Docker/Coolify: pass NEXT_PUBLIC_* as build args — they are baked in at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5062

# Optional: a different API URL for server-side requests only. Defaults to NEXT_PUBLIC_API_BASE_URL.
# API_BASE_URL=

# Public URL of this website, used for SEO metadata and social previews.
# Production: https://waytokaaba.vercel.app   (or the client's custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
